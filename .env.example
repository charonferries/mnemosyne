# Mnemosyne configuration (KEY=VALUE, no quotes)
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_NAME=mnemosyne
DB_USER=mnemosyne_app
DB_PASSWORD=app-user-password
# Migration user (DDL rights on the mnemosyne schema; used by npm run migrate)
MIGRATE_DB_USER=mnemosyne_migrate
MIGRATE_DB_PASSWORD=migrate-user-password
# Moderation key for POST /api/v1/admin/hide (X-Admin-Key header)
ADMIN_KEY=long-random-string
# Public base URL, no trailing slash
BASE_URL=https://your.domain
HOST=0.0.0.0
PORT=8095
