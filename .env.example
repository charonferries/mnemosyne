# Mnemosyne configuration (server: /opt/data/mnemosyne/.env, root-installed)
DB_HOST=coloweb-infra-db.example.eu-central-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=mnemosyne
DB_USER=mnemosyne_app
DB_PASSWORD=secret-from-coloweb-mnemosyne/db-password
# Migration user (DDL on mnemosyne.* only) — used by `npm run migrate` /
# the container's migrate-on-boot step.
MIGRATE_DB_USER=mnemosyne_migrate
MIGRATE_DB_PASSWORD=secret-from-coloweb-mnemosyne/migrate-password
# Operator moderation key (secret coloweb-mnemosyne/admin-key)
ADMIN_KEY=secret
# Public base URL, no trailing slash
BASE_URL=https://mnemosyne.tripnet.be
# Listen
HOST=0.0.0.0
PORT=8095
